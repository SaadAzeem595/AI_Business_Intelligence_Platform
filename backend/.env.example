# ==============================================================================
# AI Business Intelligence Platform - Backend Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AI Business Intelligence Platform"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL metadata store)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_bi_db
POSTGRES_PORT=5432

# Redis Cache and Celery Broker
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=dev-super-secret-key-signature-for-signature-validation-12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clerk Authentication Settings
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Enterprise Platform API Key Verification (for CI/CD pipelines)
API_KEY=admin-secret-api-key-12345

# Observability and Error Tracking
# Leave SENTRY_DSN empty to disable Sentry integrations in local development
SENTRY_DSN=
# OpenTelemetry exporter endpoint (optional, e.g. for Jaeger or OTel collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Performance and Security Controls
RATE_LIMIT_PER_MINUTE=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
