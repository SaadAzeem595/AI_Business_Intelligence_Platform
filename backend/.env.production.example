# ==============================================================================
# DataPilot AI Business Intelligence Platform - Backend Production Environment
# ==============================================================================
# Configure these variables in Azure Container Apps, App Service, or your production secrets store.

# 1. Core Application Environment
PROJECT_NAME="DataPilot AI Business Intelligence Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
NODE_ENV="production"
APP_ENV="production"

# In production, DEV_AUTH_BYPASS is strictly rejected and must be false
DEV_AUTH_BYPASS=false

# 2. Production Database (Azure Database for PostgreSQL - Flexible Server)
# Set POSTGRES_* or set full DATABASE_URL
POSTGRES_SERVER=your-postgres-server.postgres.database.azure.com
POSTGRES_USER=your_postgres_admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=ai_bi_db
POSTGRES_PORT=5432
# Alternatively, specify the direct asyncpg connection URL:
# DATABASE_URL=postgresql+asyncpg://your_postgres_admin:your_secure_postgres_password@your-postgres-server.postgres.database.azure.com:5432/ai_bi_db?ssl=require

# 3. Redis Cache & Celery Task Broker (Azure Cache for Redis)
REDIS_HOST=your-redis-cache.redis.cache.windows.net
REDIS_PORT=6380
# Alternatively, specify direct broker URLs with SSL:
# CELERY_BROKER_URL=rediss://:your_redis_key@your-redis-cache.redis.cache.windows.net:6380/0
# CELERY_RESULT_BACKEND=rediss://:your_redis_key@your-redis-cache.redis.cache.windows.net:6380/0

# 4. Security & JWT Validation
# Generate a cryptographically secure 64-character hex key: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_64_character_key_with_openssl
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Enterprise API Keys for Automation / CI/CD (comma-separated list of secure random keys)
API_KEYS=prod-secret-api-key-replace-with-random-hex

# 5. Production Clerk Authentication (LIVE MODE)
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# 6. Production Stripe SaaS Billing (LIVE MODE)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_live_webhook_signing_secret
STRIPE_GROWTH_PRICE_ID=price_your_live_growth_plan_price_id
FRONTEND_URL=https://app.yourdomain.com

# 7. AI & LLM Engine (OpenRouter / LangGraph)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your_production_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 8. CORS & Origin Policies
# Comma-separated list of allowed production frontend origins
ALLOWED_ORIGINS=https://app.yourdomain.com
RATE_LIMIT_PER_MINUTE=120

# 9. Persistent Storage Paths (mount Azure File Share or NFS volume here)
STORAGE_DIR=/app/storage
UPLOADS_DIR=/app/uploads
DUCKDB_PATH=/app/storage/rag_vector.db

# 10. Observability & Monitoring
# Set Sentry DSN for live error reporting
SENTRY_DSN=https://your_sentry_key@o0000.ingest.sentry.io/0000000
LOG_FORMAT=json
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
ENABLE_DOCS=false
