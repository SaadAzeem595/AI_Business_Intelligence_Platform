# ==============================================================================
# DataPilot AI Business Intelligence Platform - Frontend Production Environment
# ==============================================================================
# Copy this file to .env.production (or configure in Vercel / Azure Static Web Apps)

# 1. API Backend Gateway URL
# Points to your deployed FastAPI backend domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Optional internal backend URL for server-side Next.js SSR proxying within private VNet/Container network
# INTERNAL_BACKEND_URL=http://api-internal:8000

# 2. Production Clerk Authentication (LIVE MODE)
# Replace with your production Clerk keys from dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key

# Clerk Route Handlers
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 3. Production Stripe Configuration (LIVE MODE)
# Replace with your live Stripe Publishable Key from dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# 4. Security Controls
# In production, DEV_AUTH_BYPASS MUST NEVER BE SET OR MUST BE false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
NODE_ENV=production
